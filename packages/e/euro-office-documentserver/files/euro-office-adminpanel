# Euro-Office Document Server: the admin panel (127.0.0.1:9000, optional).
# Not enabled by default.
type = process
command = /usr/bin/env NODE_ENV=production-linux NODE_CONFIG_DIR=/etc/euro-office/documentserver NODE_DISABLE_COLORS=1 APPLICATION_NAME=Euro-Office /usr/bin/node /var/www/euro-office/documentserver/server/AdminPanel/server/sources/server.js
working-dir = /var/www/euro-office/documentserver/server/AdminPanel
run-as = ds
logfile = /var/log/euro-office/documentserver/adminpanel/out.log
restart = true
depends-on: rcboot
