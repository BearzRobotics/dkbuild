-- git-annex 10.20261026's dependencies for GHC 9.14.1: Alpine's freeze
-- (git-annex-10.20261026-edge.cabal, made by Alpine's maintainer with `cabal
-- v2-freeze --strong-flags` and the flags Alpine builds with, sha512 as in
-- aports community/git-annex/APKBUILD), with botan-bindings +pkg-config
-- (Alpine edits the same line: botan's headers are found through
-- pkg-config), the system's SQLite and xxHash instead of the copies
-- persistent-sqlite and xxhash-ffi bundle (persistent-sqlite +systemlib
-- +use-pkgconfig, xxhash-ffi +pkg-config), blake3 0.3 added (git-annex's
-- Blake3 flag needs it on x86_64; the freeze has none, as if made where the
-- flag is ignored: arm; 0.3, as 0.3.1 moved from memory to ram and this
-- build uses memory), and its active-repositories and index-state lines left
-- out: they name hackage.haskell.org, and the build's only repository is
-- dkbuild's.
constraints: any.Cabal ==3.16.1.0,
             Cabal -git-rev,
             any.Cabal-syntax ==3.16.1.0,
             any.DAV ==1.3.4,
             DAV -mtl-compat,
             any.Glob ==0.10.2,
             any.HUnit ==1.6.2.0,
             any.IfElse ==0.85,
             any.OneTuple ==0.4.3,
             OneTuple +base-ge-4-15 +base-ge-4-16,
             any.Only ==0.1,
             any.QuickCheck ==2.18.0.0,
