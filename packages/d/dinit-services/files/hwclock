# Set system time from hardware clock

type = scripted
# hwclock --hctosys, and where that times out, again with --directisa
command = /etc/dinit.d/hwclock.sh
log-type = buffer

# Optional, not necessary, and not recommended:
#stop-command = /sbin/hwclock --systohc

restart = false

depends-on: udevd
waits-for: udev-settle
depends-on: early-filesystems
