# Hardware support for a standard desktop or laptop, merged over the DKRescue (VM-oriented) base config with scripts/kconfig/merge_config.sh
# before olddefconfig. Written 2026-11-16 after an ASUS Vivobook booted the dkde ISO with a dead touchpad (the base config had no PINCTRL and no
# I2C DesignWare controller driver, so the touchpad, an I2C-HID device behind the SoC's I2C controller and a pinctrl-routed interrupt, never
# appeared) and without Bluetooth, audio codecs, a webcam driver or the vendor WMI driver; expanded the same day to the whole desktop/laptop
# case. Priorities: the AMD stack first (Ryzen CPUs, amdgpu, ACP/PMF/PMC platform drivers), then Intel, then the open-source NVIDIA stack
# (nouveau; the Rust-based nova driver once the kernel is built with Rust). Symbols that do not exist in a kernel version are ignored by
# olddefconfig; the recipe's setup step checks that the ones that matter stayed on.
# Sections: CPU and platform | graphics | power | memory | storage and filesystems | network | input | audio | USB, Thunderbolt, cameras |
#           laptop vendors | security | misc

# --- pin control and I2C controllers (touchpads, touchscreens, sensors sit behind these) ---
CONFIG_PINCTRL=y
CONFIG_PINCTRL_AMD=y
CONFIG_PINCTRL_INTEL=y
CONFIG_PINCTRL_INTEL_PLATFORM=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_PINCTRL_METEORPOINT=y
CONFIG_PINCTRL_LUNARLAKE=y
CONFIG_PINCTRL_RAPTORLAKE=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_JASPERLAKE=y
CONFIG_PINCTRL_ELKHARTLAKE=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_GEMINILAKE=y
CONFIG_PINCTRL_BROXTON=y
CONFIG_PINCTRL_CHERRYVIEW=y
CONFIG_PINCTRL_BAYTRAIL=y
CONFIG_GPIO_AMDPT=m
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_AMDPSP=y
CONFIG_I2C_DESIGNWARE_BAYTRAIL=y
CONFIG_I2C_DESIGNWARE_PCI=m
CONFIG_I2C_AMD_MP2=m
CONFIG_I2C_I801=m
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_X86_AMD_PLATFORM_DEVICE=y
CONFIG_ACPI_WMI=y
CONFIG_ACPI_PLATFORM_PROFILE=y

# --- input: I2C-HID touchpads (ELAN, ASUE, Synaptics, ...), PS/2 and SMBus touchpads, sensors ---
CONFIG_I2C_HID_CORE=y
CONFIG_I2C_HID_ACPI=y
CONFIG_HID_MULTITOUCH=y
CONFIG_HID_ASUS=y
CONFIG_HID_RMI=m
CONFIG_RMI4_CORE=m
CONFIG_RMI4_I2C=m
CONFIG_RMI4_SMB=m
CONFIG_RMI4_F03=y
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y
CONFIG_RMI4_F30=y
CONFIG_RMI4_F3A=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_ELANTECH_SMBUS=y
CONFIG_MOUSE_ELAN_I2C=m
CONFIG_MOUSE_ELAN_I2C_I2C=y
CONFIG_MOUSE_ELAN_I2C_SMBUS=y
CONFIG_HID_SENSOR_HUB=m
CONFIG_INPUT_SPARSEKMAP=y

# --- laptop platform drivers (hotkeys, keyboard backlight, fan/performance profiles) ---
CONFIG_ASUS_WMI=m
CONFIG_ASUS_NB_WMI=m
CONFIG_ASUS_WIRELESS=m
CONFIG_INTEL_HID_EVENT=m
CONFIG_INTEL_VBTN=m
CONFIG_INTEL_PMC_CORE=m
CONFIG_INTEL_RAPL=m
CONFIG_AMD_PMC=m
CONFIG_AMD_PMF=m

# --- Bluetooth (bluez is part of the desktop) ---
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_AUTOSUSPEND=y
