# --- nftables expressions ---
# The base config had the nf_tables core, conntrack, NAT, masquerade, reject and
# FIB lookups, but none of the expressions firewalld, nft rulesets and Incus use
# for logging, rate limits, quotas, redirect, tproxy, sockets, named maps and
# flow offload: `nft` fails with "Operation not supported" on those rules.
CONFIG_NF_TABLES_ARP=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_NUMGEN=m
CONFIG_NFT_HASH=m
CONFIG_NFT_CONNLIMIT=m
CONFIG_NFT_QUEUE=m
CONFIG_NFT_SOCKET=m
CONFIG_NFT_TPROXY=m
CONFIG_NFT_XFRM=m
CONFIG_NFT_OSF=m
CONFIG_NFT_TUNNEL=m
CONFIG_NFT_SYNPROXY=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_FIB_NETDEV=m
CONFIG_NFT_DUP_NETDEV=m
CONFIG_NFT_FWD_NETDEV=m
CONFIG_NF_FLOW_TABLE=m
CONFIG_NF_FLOW_TABLE_INET=m
CONFIG_NFT_FLOW_OFFLOAD=m
