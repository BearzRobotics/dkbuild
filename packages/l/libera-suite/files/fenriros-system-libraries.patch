FenrirOS: Libera Suite's core (Euro-Office core at Libera's pin, with
Libera's patch queue applied first) built against the system's ICU, Boost and
OpenSSL and the euro-office-v8 package, where core's build_3rdparty.py would
build its own (ICU 74, Boost 1.83, OpenSSL 1.1.1f, V8 8.9.45; the recipe
skips it with THIRD_PARTY_PREPARED). The same change as euro-office-core's
patches/system-libraries.patch, on this tree (Libera's 0024 already lets
EO_CORE_OPENSSL_DIR name the OpenSSL; the recipe passes /usr):
- ICU: the system's shared libraries by their unversioned names; core no
  longer copies ICU next to x2t (copy_icu_libs, Linux branch).
- Boost: the system's, through its CMake config, as shared libraries;
  Boost::system (header-only since 1.69, no library since 1.89) becomes an
  interface target when Boost's config has none.
- OpenSSL: shared libraries under EO_CORE_OPENSSL_DIR/lib (core expects
  static ones under lib64).
- V8: /usr/lib/euro-office-v8 (euro-office-v8: the same V8 8.9.45 and GN that
  this core pins).

--- a/common.cmake
+++ b/common.cmake
@@ -1,7 +1,7 @@
 include_guard(GLOBAL)
 
 if(POLICY CMP0167)
-    cmake_policy(SET CMP0167 OLD)
+    cmake_policy(SET CMP0167 NEW)
 endif()
 
 set(CMAKE_CXX_STANDARD 17)
@@ -199,7 +199,7 @@
     # These version numbers don't affect what build_3rdparty.py builds. They just have to match.
     set(ICU_MAJOR_VER "74")
     set(ICU_MINOR_VER "2")
-    set(ICU_INSTALL_DIR "${EO_CORE_3RD_PARTY_INSTALL_DIR}/icu")
+    set(ICU_INSTALL_DIR "/usr")
     get_filename_component(ICU_INSTALL_DIR_ABS "${ICU_INSTALL_DIR}" ABSOLUTE)
     if( MSVC )
         set(LIBICUUC "${ICU_INSTALL_DIR_ABS}/lib/icuuc.lib")
@@ -210,21 +210,20 @@
         set(LIBICUDATA "${ICU_INSTALL_DIR_ABS}/lib/libicudata.${ICU_MAJOR_VER}.dylib")
         set(LIBICUI "${ICU_INSTALL_DIR_ABS}/lib/libicui18n.${ICU_MAJOR_VER}.dylib")
     else()
-        set(LIBICUUC "${ICU_INSTALL_DIR_ABS}/lib/libicuuc.so.${ICU_MAJOR_VER}")
-        set(LIBICUDATA "${ICU_INSTALL_DIR_ABS}/lib/libicudata.so.${ICU_MAJOR_VER}")
-        set(LIBICUI "${ICU_INSTALL_DIR_ABS}/lib/libicui18n.so.${ICU_MAJOR_VER}")
+        set(LIBICUUC "/usr/lib/libicuuc.so")
+        set(LIBICUDATA "/usr/lib/libicudata.so")
+        set(LIBICUI "/usr/lib/libicui18n.so")
     endif()
 
     # Setup boost
-    set( BOOST_INSTALL_DIR "${EO_CORE_3RD_PARTY_INSTALL_DIR}/boost" )
-    get_filename_component(BOOST_INSTALL_DIR_ABS "${BOOST_INSTALL_DIR}" ABSOLUTE)
-    list( APPEND CMAKE_PREFIX_PATH "${BOOST_INSTALL_DIR_ABS}" )
-    include_directories( "${BOOST_INSTALL_DIR_ABS}/include" )
-    set(Boost_USE_STATIC_LIBS ON)
-    find_package( Boost REQUIRED COMPONENTS system filesystem regex date_time )
+    find_package( Boost CONFIG REQUIRED COMPONENTS filesystem regex date_time )
+    if(NOT TARGET Boost::system)
+        add_library(Boost::system INTERFACE IMPORTED)
+        target_link_libraries(Boost::system INTERFACE Boost::headers)
+    endif()
 
     # Setup v8
-    set(V8_INSTALL_DIR "${EO_CORE_3RD_PARTY_INSTALL_DIR}/v8")
+    set(V8_INSTALL_DIR "/usr/lib/euro-office-v8")
     get_filename_component(V8_INSTALL_DIR_ABS "${V8_INSTALL_DIR}" ABSOLUTE)
     if( MSVC )
         set(V8_MONOLITH "${V8_INSTALL_DIR_ABS}/v8_monolith.lib")
@@ -252,8 +251,8 @@
         set(OPENSSL_LIBSSL "${OPENSSL_INSTALL_DIR_ABS}/lib/libssl.a")
         set(OPENSSL_LIBCRYPTO "${OPENSSL_INSTALL_DIR_ABS}/lib/libcrypto.a")
     else()
-        set(OPENSSL_LIBSSL "${OPENSSL_INSTALL_DIR_ABS}/lib64/libssl.a")
-        set(OPENSSL_LIBCRYPTO "${OPENSSL_INSTALL_DIR_ABS}/lib64/libcrypto.a")
+        set(OPENSSL_LIBSSL "${OPENSSL_INSTALL_DIR_ABS}/lib/libssl.so")
+        set(OPENSSL_LIBCRYPTO "${OPENSSL_INSTALL_DIR_ABS}/lib/libcrypto.so")
     endif()
 
 endif()
@@ -584,12 +583,6 @@
         COMMAND /bin/sh -c "cp -P \"${EO_CORE_3RD_PARTY_INSTALL_DIR}/icu/lib\"/*.dylib* \"${EO_CORE_OUTPUT_DIR}/\""
         COMMENT "Copying ICU libs to ${EO_CORE_OUTPUT_DIR}"
     )
-    else()
-        add_custom_command(TARGET ${artifact} POST_BUILD
-            COMMAND ${CMAKE_COMMAND} -E make_directory "${EO_CORE_OUTPUT_DIR}"
-            COMMAND /bin/sh -c "cp -P \"${EO_CORE_3RD_PARTY_INSTALL_DIR}/icu/lib\"/*.so* \"${EO_CORE_OUTPUT_DIR}/\""
-            COMMENT "Copying ICU libs to ${EO_CORE_OUTPUT_DIR}"
-        )
     endif()
 endfunction()
 
