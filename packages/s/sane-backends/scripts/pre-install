#!/bin/sh
# an account that cannot be made fails the script, so that apk says so
set -e
grep -q "^scanner:" /etc/group || groupadd -r scanner
grep -q "^saned:" /etc/group || groupadd -r saned
grep -q "^saned:" /etc/passwd || useradd -r -g saned -G lp,scanner -d /var/empty -s /usr/bin/nologin -c "SANE daemon" saned
