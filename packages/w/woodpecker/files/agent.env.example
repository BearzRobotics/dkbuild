# /etc/woodpecker/agent.env
# the server's gRPC address (the server's WOODPECKER_GRPC_ADDR, default :9000)
WOODPECKER_SERVER=127.0.0.1:9000
# the same secret as the server's WOODPECKER_AGENT_SECRET
WOODPECKER_AGENT_SECRET=
# backend: docker (needs the woodpecker-agent user in the docker group and
# the docker service), kubernetes or local
WOODPECKER_BACKEND=docker
WOODPECKER_MAX_WORKFLOWS=2
