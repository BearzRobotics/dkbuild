# /etc/woodpecker/server.env (KEY=value, one per line, no quotes needed).
# The web address, and the shared secret the agents use (make one with
# `openssl rand -hex 32`):
WOODPECKER_HOST=https://ci.example.org
WOODPECKER_AGENT_SECRET=
WOODPECKER_SERVER_ADDR=127.0.0.1:8000
# the forge: Gitea / Forgejo (the "gitea" driver)
#WOODPECKER_GITEA=true
#WOODPECKER_GITEA_URL=https://git.example.org
#WOODPECKER_GITEA_CLIENT=
#WOODPECKER_GITEA_SECRET=
# the first login's user becomes admin only if listed here
#WOODPECKER_ADMIN=someuser
# registration is closed unless this is true (or WOODPECKER_ORGS limits it)
#WOODPECKER_OPEN=false
# the default database is SQLite at /var/lib/woodpecker/woodpecker.sqlite
WOODPECKER_DATABASE_DATASOURCE=/var/lib/woodpecker/woodpecker.sqlite
