+/* Calls the handler of one of reiserfs' own conversions (%K %k %H %b %y %M %U) for the pointer. */
+static int custom_conv(FILE * fp, int conv, const struct printf_info *pi,
+		       const void *ptr)
+{
+	const void *const args[1] = { &ptr };
+
+	switch (conv) {
+	case 'K':
+		return print_short_key(fp, pi, args);
+	case 'k':
+		return print_key(fp, pi, args);
+	case 'H':
+		return print_item_head(fp, pi, args);
+	case 'b':
+		return print_block_head(fp, pi, args);
+	case 'y':
+		return print_disk_child(fp, pi, args);
+	case 'M':
+		return print_sd_mode(fp, pi, args);
+	case 'U':
+		return print_sd_uuid(fp, pi, args);
+	}
+	return -1;
+}
+
+/* Appends the decimal number n to the conversion spec being built. */
+static void spec_add_int(char *spec, size_t *n, int v)
+{
+	*n += snprintf(spec + *n, 24, "%d", v);
+}
