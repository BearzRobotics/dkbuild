export PATH=/usr/bin:/usr/sbin
# bash understands its prompt escapes; a POSIX sh (dash) gets the same prompt
# built here, with $PWD expanded each time it is shown.
if [ -n "${BASH_VERSION:-}" ]; then
    PS1='\[\e[1;36m\]\u\[\e[1;35m\]@\[\e[1;33m\]\h\[\e[1;34m\] \w \$\[\e[0m\] '
else
    _e=$(printf '\033')
    _p='$'; [ "$(id -u)" = 0 ] && _p='#'
    PS1="${_e}[1;36m$(id -un)${_e}[1;35m@${_e}[1;33m$(hostname 2>/dev/null || cat /etc/hostname)${_e}[1;34m "'${PWD}'" ${_p}${_e}[0m "
    unset _e _p
fi
export PS1
alias ls='ls --color=auto'
