# /etc/shrc: settings for interactive shells, sh/dash and bash alike.
# ~/.shrc and ~/.bashrc read it; put your own changes in those.
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias ip='ip -color=auto'

if [ -n "${BASH_VERSION:-}" ]; then
    PS1='\[\e[1;36m\]\u\[\e[1;35m\]@\[\e[1;33m\]\h\[\e[1;34m\] \w \$\[\e[0m\] '
else
    # dash has no prompt escapes: build the same prompt, $PWD expanded each time.
    _e=$(printf '\033')
    _p='$'; [ "$(id -u)" = 0 ] && _p='#'
    PS1="${_e}[1;36m$(id -un)${_e}[1;35m@${_e}[1;33m$(hostname 2>/dev/null || cat /etc/hostname)${_e}[1;34m "'${PWD}'" ${_p}${_e}[0m "
    unset _e _p
fi
