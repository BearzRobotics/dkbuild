# /usr/share/bash/bashrc

if [ -e /etc/bash/bashrc ]; then
    . /etc/bash/bashrc
    return
fi

if [[ $- != *i* ]] ; then
    # non-interactive shell
    return
fi

# Every *.sh in the bashrc.d directories (bash-completion's hook is one).
for bashrc_d in /etc/bash/bashrc.d/*.sh /usr/share/bash/bashrc.d/*.sh; do
    [ -r "$bashrc_d" ] && . "$bashrc_d"
done
unset bashrc_d
