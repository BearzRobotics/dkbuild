#---------------------------------------------------------------------
# Example configuration: an HTTP proxy listening on port 80 on all
# interfaces and forwarding requests to a single backend "servers" with a
# single server "server1" listening on 127.0.0.1:8000. Copy it to
# /etc/haproxy/haproxy.cfg to use it.
#
# More: https://docs.haproxy.org/ and /usr/share/haproxy/examples/
#---------------------------------------------------------------------

global
    daemon
    maxconn 256
    chroot      /var/empty
    user        haproxy
    group       haproxy

defaults
    mode http
    timeout connect 5000ms
    timeout client 50000ms
    timeout server 50000ms

frontend http-in
    bind *:80
    default_backend servers

backend servers
    server server1 127.0.0.1:8000 maxconn 32
