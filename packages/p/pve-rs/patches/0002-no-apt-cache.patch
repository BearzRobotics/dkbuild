FenrirOS has no APT: build proxmox-apt without its "cache" feature, which
links Debian's libapt-pkg (apt-pkg-native) for the package cache, and leave
out the three Proxmox::RS::APT::Repositories functions that need it
(list_available_apt_update, update_database, get_package_versions).
pve-manager's updates API is an apk implementation on FenrirOS and does not
call them; the repository functions (list/add/change, changelog) stay.
Written for FenrirOS.

--- a/pve-rs/Cargo.toml
+++ b/pve-rs/Cargo.toml
@@ -30,7 +30,7 @@
 
 perlmod = { version = "0.14", features = ["exporter"] }
 
-proxmox-apt = { version = "1.0.1", features = ["cache"] }
+proxmox-apt = { version = "1.0.1" }
 proxmox-apt-api-types = "3"
 proxmox-base64 = "1"
 proxmox-config-digest = "1"
--- a/common/src/bindings/apt_repositories.rs
+++ b/common/src/bindings/apt_repositories.rs
@@ -8,7 +8,7 @@
 
     use proxmox_apt_api_types::{
         APTChangeRepositoryOptions, APTGetChangelogOptions, APTRepositoriesResult,
-        APTRepositoryHandle, APTUpdateInfo, APTUpdateOptions, HostProduct,
+        APTRepositoryHandle, HostProduct,
     };
     use proxmox_config_digest::ConfigDigest;
 
@@ -70,49 +70,8 @@
         proxmox_apt::get_changelog(&options)
     }
 
