diff -ruN a/fenrir/proxmox-systemd/src/notify.rs b/fenrir/proxmox-systemd/src/notify.rs
--- a/fenrir/proxmox-systemd/src/notify.rs
+++ b/fenrir/proxmox-systemd/src/notify.rs
@@ -0,0 +1,124 @@
+use std::ffi::{CStr, CString, c_char, c_void};
+use std::io;
+use std::os::fd::{AsFd, AsRawFd, RawFd};
+
+use crate::sys;
+
+/// Systemd service startup states (see: ``man sd_notify``)
+#[derive(Clone, Debug)]
+pub enum SystemdNotify {
+    Ready,
+    Reloading,
+    Stopping,
+    Status(String),
+    MainPid(libc::pid_t),
+}
+
+impl SystemdNotify {
+    /// Tells systemd the startup state of the service (see: ``man sd_notify``)
+    ///
+    /// If a `SystemdNotify::Status` message cannot be converted to a C-String this returns an
+    /// `io::ErrorKind::InvalidInput`.
+    pub fn notify(self) -> Result<(), io::Error> {
+        let cs;
+        let message = match self {
+            SystemdNotify::Ready => c"READY=1",
+            SystemdNotify::Reloading => c"RELOADING=1",
+            SystemdNotify::Stopping => c"STOPPING=1",
+            SystemdNotify::Status(msg) => {
+                cs = CString::new(msg)?;
+                &cs
+            }
+            SystemdNotify::MainPid(pid) => {
+                cs = CString::new(format!("MAINPID={pid}"))?;
+                &cs
+            }
+        };
+        sys::check_call(unsafe { sys::sd_notify(0, message.as_ptr()) }).map(drop)
+    }
+}
+
+/// Waits until all previously sent messages with sd_notify are processed
+pub fn barrier(timeout: u64) -> Result<(), io::Error> {
+    sys::check_call(unsafe { sys::sd_notify_barrier(0, timeout) }).map(drop)
+}
+
+/// Store a set of file descriptors in systemd's file descriptor store for this service.
+pub fn store_fds(name: &str, fds: &[RawFd]) -> Result<(), io::Error> {
+    validate_name(name)?;
+
+    let message = CString::new(format!("FDSTORE=1\nFDNAME={name}"))?;
+
+    sys::check_call(unsafe {
+        sys::sd_pid_notify_with_fds(0, 0, message.as_ptr(), fds.as_ptr(), fds.len() as _)
+    })
+    .map(drop)
+}
+
+/// Store a file descriptor in systemd's file descriptor store for this service.
+pub fn store_fd<F: AsFd + ?Sized>(name: &str, fds: &F) -> Result<(), io::Error> {
+    store_fds(name, &[fds.as_fd().as_raw_fd()])
+}
+
+/// Validate a name for the `FDNAME=` argument (see `man sd_pid_notify_with_fds`).
+fn validate_name(name: &str) -> Result<(), io::Error> {
+    for b in name.as_bytes() {
+        if *b == b':' || b.is_ascii_control() {
+            return Err(io::Error::other("invalid file descriptor name"));
+        }
+    }
+    Ok(())
+}
+
+/// An iterator over the file descriptor names in the systemd file descriptor store.
+pub struct ListenFdNames {
+    ptr: *mut *mut c_char,
+    cur: usize,
+    len: usize,
+}
+
+impl ListenFdNames {
+    /// Query the file descriptor names and numbers stored in the systemd file descriptor store.
+    pub fn query() -> Result<Self, io::Error> {
+        let mut names = std::ptr::null_mut();
+        let count = sys::check_call(unsafe { sys::sd_listen_fds_with_names(0, &mut names) })?;
+        Ok(Self {
+            ptr: names,
+            cur: 0,
+            len: count as usize,
+        })
+    }
+
+    fn as_array(&self) -> &[*mut c_char] {
+        if self.ptr.is_null() {
+            &[]
+        } else {
+            unsafe { std::slice::from_raw_parts(self.ptr, self.len) }
+        }
+    }
+}
+
+impl Drop for ListenFdNames {
+    fn drop(&mut self) {
+        for name in self.as_array() {
+            unsafe { libc::free(*name as *mut c_void) }
+        }
+    }
+}
+
+impl Iterator for ListenFdNames {
+    type Item = (RawFd, Result<String, std::string::FromUtf8Error>);
+
+    fn next(&mut self) -> Option<Self::Item> {
+        let names = self.as_array();
+        if self.cur >= names.len() {
+            return None;
+        }
+
+        let ptr = names[self.cur] as *const c_char;
+        let fd_num = (self.cur as RawFd) + sys::LISTEN_FDS_START;
+        self.cur += 1;
+        let name = String::from_utf8(unsafe { CStr::from_ptr(ptr) }.to_bytes().to_vec());
+        Some((fd_num, name))
+    }
+}
diff -ruN a/fenrir/proxmox-systemd/src/sd_id128.rs b/fenrir/proxmox-systemd/src/sd_id128.rs
--- a/fenrir/proxmox-systemd/src/sd_id128.rs
+++ b/fenrir/proxmox-systemd/src/sd_id128.rs
@@ -0,0 +1,125 @@
+//! Safe wrappers around systemd's `sd-id128` 128-bit ID APIs.
+//!
+//! `sd-id128.h` is part of `libsystemd` and provides APIs to generate, convert, and compare
+//! 128-bit ID values, which are a generalization of RFC 4122 OSF UUIDs with a simpler string
+//! format. See `sd-id128(3)` for the full C API.
+//!
+//! See [`get_app_specific_id`] for deriving a stable, application-specific ID from the local
+//! machine ID (`sd_id128_get_machine_app_specific(3)`, `machine-id(5)`), and [`SystemdId128Error`]
+//! for the errors it can return.
+
+use std::fmt;
+
+use crate::sys::{self, sd_id128_t};
+
+/// Errors that can occur when deriving an application-specific ID from the local machine ID.
+///
+/// See `sd_id128_get_machine_app_specific(3)` and `sd-id128(3)` for background on the underlying
+/// systemd API.
+#[derive(Debug, PartialEq, Eq)]
+pub enum SystemdId128Error {
+    /// The supplied application ID is not a valid `sd_id128_t` value.
+    ///
+    /// Currently this is returned when `app_id` consists entirely of zero bytes, which systemd
+    /// treats as the "null" ID. A valid application ID should be generated once per application
+    /// (for example with `systemd-id128 new`) and then hard-coded into the program.
+    InvalidAppId,
+    /// systemd was unable to derive an application-specific ID from the local machine ID.
+    ///
+    /// This typically means that no machine ID is available on the system, e.g. `/etc/machine-id`
+    /// is missing, empty, or otherwise unreadable. See `machine-id(5)` for details on how the
+    /// machine ID is provisioned.
+    GenerationError,
+}
+
+impl std::error::Error for SystemdId128Error {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        None
+    }
+}
+
+impl fmt::Display for SystemdId128Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            SystemdId128Error::InvalidAppId => f.write_str("Provided application ID is invalid."),
+            SystemdId128Error::GenerationError => {
+                f.write_str("Failed to generate machine-id based on application ID.")
+            }
+        }
+    }
+}
+
+/// Derives a stable, application-specific 128-bit ID from the local machine ID.
+///
+/// This is a safe Rust wrapper around systemd's `sd_id128_get_machine_app_specific(3)`.
+/// It combines the host's machine ID (as exposed by `sd_id128_get_machine(3)` and documented in
+/// `machine-id(5)`) with the caller-supplied `app_id` via an HMAC-based construction, and returns
+/// the resulting 128-bit value.
+///
+/// Properties of the returned ID, as guaranteed by the underlying systemd API:
+///
+/// - **Stable**: repeated calls on the same machine with the same `app_id` always yield the
+///   same value, so the ID may be persisted and compared across reboots.
+/// - **Per-machine**: the same `app_id` evaluated on a different machine produces a different,
+///   unrelated value; the machine ID cannot be recovered from the result.
+/// - **Per-application**: different `app_id` values on the same machine produce unrelated
+///   values, so IDs generated by different applications cannot be correlated without knowing
+///   each application's `app_id`.
+///
+/// This makes the function suitable whenever an application needs a per-installation identifier
+/// without leaking the machine ID itself.
+///
+/// # Arguments
+///
+/// * `app_id` - A 16-byte `sd_id128_t` value identifying the application. It must not be all
+///   zeros. Per the systemd documentation, this value should be generated once (for example
+///   with `systemd-id128 new`) and then compiled into the application as a constant.
+///
+/// # Errors
+///
+/// * [`SystemdId128Error::InvalidAppId`] if `app_id` is the null ID (all zero bytes).
+/// * [`SystemdId128Error::GenerationError`] if systemd could not derive an ID, which generally
+///   indicates that no machine ID is available on the running system.
+pub fn get_app_specific_id(app_id: [u8; 16]) -> Result<[u8; 16], SystemdId128Error> {
+    let mut res = sd_id128_t { bytes: [0; 16] };
+
+    if app_id.iter().all(|b| *b == 0) {
+        return Err(SystemdId128Error::InvalidAppId);
+    }
+    unsafe {
+        sys::sd_id128_get_machine_app_specific(sd_id128_t { bytes: app_id }, &mut res);
+    }
+    if res.bytes.iter().all(|b| *b == 0) {
+        return Err(SystemdId128Error::GenerationError);
+    }
+    Ok(res.bytes)
+}
+
+#[test]
+fn test_invalid_app_id() {
+    let invalid = [0; 16];
+    let res = get_app_specific_id(invalid);
+    assert!(res.is_err());
+    assert_eq!(res, Err(SystemdId128Error::InvalidAppId));
+}
+
+#[test]
+fn test_valid_app_id() {
+    // no machine-id, no app-specific ID either..
+    if !std::path::Path::new("/etc/machine-id").exists() {
+        return;
+    }
+
+    // UUID generated with `systemd-id128 new` and converted from hex
+    let valid = 950247666410175165299169499632875718_u128.to_le_bytes();
+
+    let res = get_app_specific_id(valid);
+    assert!(res.is_ok());
+
+    let res2 = get_app_specific_id(valid);
+    assert!(res2.is_ok());
+
+    // cannot verify the expected result, since that depends on the machine the test runs on
+    // we can verify that two generations using the same machine and app-id give identical results
+    assert_eq!(res, res2);
+}
diff -ruN a/fenrir/proxmox-systemd/src/sys.rs b/fenrir/proxmox-systemd/src/sys.rs
--- a/fenrir/proxmox-systemd/src/sys.rs
+++ b/fenrir/proxmox-systemd/src/sys.rs
@@ -0,0 +1,323 @@
+//! FenrirOS: the libsystemd functions this crate used, written in Rust.
+//!
+//! FenrirOS has no systemd and no libsystemd. Upstream declares these
+//! functions in an `extern "C"` block linked against libsystemd; here they are
+//! Rust functions with the same signatures and return conventions (a negative
+//! errno on failure), so the rest of the crate is unchanged:
+//! - sd_notify, sd_pid_notify_with_fds: the sd_notify datagram protocol, sent
+//!   to $NOTIFY_SOCKET when it is set (file descriptors as SCM_RIGHTS); without
+//!   it (dinit), nothing is sent and 0 is returned, as libsystemd does.
+//! - sd_notify_barrier: 0 without $NOTIFY_SOCKET, else -ENOSYS.
+//! - sd_listen_fds_with_names: socket activation from $LISTEN_PID, $LISTEN_FDS
+//!   and $LISTEN_FDNAMES, as libsystemd reads them.
+//! - sd_journal_stream_fd: there is no journal; a duplicate of stderr.
+//! - sd_id128_get_machine_app_specific: systemd's derivation, HMAC-SHA256
+//!   keyed with /etc/machine-id over the application ID, as a v4 UUID.
+
+use std::ffi::{CStr, c_char, c_int, c_uchar, c_uint};
+use std::io;
+use std::os::fd::RawFd;
+
+pub const LISTEN_FDS_START: RawFd = 3;
+
+#[repr(C)]
+pub struct sd_id128_t {
+    pub bytes: [u8; 16],
+}
+
+pub fn check_call(ret: c_int) -> Result<c_int, io::Error> {
+    if ret < 0 {
+        Err(io::Error::from_raw_os_error(-ret))
+    } else {
+        Ok(ret)
+    }
+}
+
+fn errno() -> c_int {
+    io::Error::last_os_error().raw_os_error().unwrap_or(libc::EIO)
+}
+
+fn unset_notify_env() {
+    // SAFETY: as libsystemd, callers ask for this from single-threaded setup code.
+    unsafe { std::env::remove_var("NOTIFY_SOCKET") };
+}
+
+/// Send `state` (and `fds`) to $NOTIFY_SOCKET: >0 when sent, 0 when not set.
+unsafe fn notify_send(unset_environment: c_int, state: *const c_char, fds: &[c_int]) -> c_int {
+    let path = match std::env::var_os("NOTIFY_SOCKET") {
+        Some(p) => p,
+        None => return 0,
+    };
+    if unset_environment != 0 {
+        unset_notify_env();
+    }
+    if state.is_null() {
+        return -libc::EINVAL;
+    }
+    let msg = unsafe { CStr::from_ptr(state) }.to_bytes();
+    let path = std::os::unix::ffi::OsStrExt::as_bytes(path.as_os_str());
+    if path.is_empty() || path.len() >= 108 || (path[0] != b'/' && path[0] != b'@') {
+        return -libc::EINVAL;
+    }
+
+    let mut addr: libc::sockaddr_un = unsafe { std::mem::zeroed() };
+    addr.sun_family = libc::AF_UNIX as libc::sa_family_t;
+    for (i, b) in path.iter().enumerate() {
+        addr.sun_path[i] = *b as c_char;
+    }
+    // '@': an abstract socket, a leading NUL byte and no terminator
+    let addr_len = if path[0] == b'@' {
+        addr.sun_path[0] = 0;
+        std::mem::size_of::<libc::sa_family_t>() + path.len()
+    } else {
+        std::mem::size_of::<libc::sa_family_t>() + path.len() + 1
+    };
+
+    let fd = unsafe { libc::socket(libc::AF_UNIX, libc::SOCK_DGRAM | libc::SOCK_CLOEXEC, 0) };
+    if fd < 0 {
+        return -errno();
+    }
+
+    let mut iov = libc::iovec {
+        iov_base: msg.as_ptr() as *mut libc::c_void,
+        iov_len: msg.len(),
+    };
+    let fds_len = std::mem::size_of_val(fds);
+    let space = if fds.is_empty() {
+        0
+    } else {
+        unsafe { libc::CMSG_SPACE(fds_len as c_uint) as usize }
+    };
+    let mut control = vec![0u8; space];
+    let mut mh: libc::msghdr = unsafe { std::mem::zeroed() };
+    mh.msg_name = &mut addr as *mut libc::sockaddr_un as *mut libc::c_void;
+    mh.msg_namelen = addr_len as libc::socklen_t;
+    mh.msg_iov = &mut iov;
+    mh.msg_iovlen = 1;
+    if !fds.is_empty() {
+        mh.msg_control = control.as_mut_ptr() as *mut libc::c_void;
+        mh.msg_controllen = space as _;
+        unsafe {
+            let cmsg = libc::CMSG_FIRSTHDR(&mh);
+            (*cmsg).cmsg_level = libc::SOL_SOCKET;
+            (*cmsg).cmsg_type = libc::SCM_RIGHTS;
+            (*cmsg).cmsg_len = libc::CMSG_LEN(fds_len as c_uint) as _;
+            std::ptr::copy_nonoverlapping(fds.as_ptr(), libc::CMSG_DATA(cmsg) as *mut c_int, fds.len());
+        }
+    }
+
+    let r = unsafe { libc::sendmsg(fd, &mh, libc::MSG_NOSIGNAL) };
+    let ret = if r < 0 { -errno() } else { 1 };
+    unsafe { libc::close(fd) };
+    ret
+}
+
+pub unsafe fn sd_notify(unset_environment: c_int, state: *const c_char) -> c_int {
+    unsafe { notify_send(unset_environment, state, &[]) }
+}
+
+pub unsafe fn sd_notify_barrier(unset_environment: c_int, _timeout: u64) -> c_int {
+    if std::env::var_os("NOTIFY_SOCKET").is_none() {
+        return 0;
+    }
+    if unset_environment != 0 {
+        unset_notify_env();
+    }
+    -libc::ENOSYS
+}
+
+pub unsafe fn sd_pid_notify_with_fds(
+    _pid: libc::pid_t,
+    unset_environment: c_int,
+    state: *const c_char,
+    fds: *const c_int,
+    n_fds: c_uint,
+) -> c_int {
+    let fds = if fds.is_null() || n_fds == 0 {
+        &[][..]
+    } else {
+        unsafe { std::slice::from_raw_parts(fds, n_fds as usize) }
+    };
+    unsafe { notify_send(unset_environment, state, fds) }
+}
+
+pub unsafe fn sd_listen_fds_with_names(
+    unset_environment: c_int,
+    names: *mut *mut *mut c_char,
+) -> c_int {
+    let pid_ok = std::env::var("LISTEN_PID")
+        .ok()
+        .and_then(|p| p.parse::<libc::pid_t>().ok())
+        .map(|p| p == unsafe { libc::getpid() })
+        .unwrap_or(false);
+    let count = if pid_ok {
+        match std::env::var("LISTEN_FDS").ok().and_then(|n| n.parse::<c_int>().ok()) {
+            Some(n) if n >= 0 => n,
+            Some(_) => return -libc::EINVAL,
+            None => 0,
+        }
+    } else {
+        0
+    };
+    let fdnames = std::env::var("LISTEN_FDNAMES").ok();
+    if unset_environment != 0 {
+        // SAFETY: as libsystemd, callers ask for this from single-threaded setup code.
+        unsafe {
+            std::env::remove_var("LISTEN_PID");
+            std::env::remove_var("LISTEN_FDS");
+            std::env::remove_var("LISTEN_FDNAMES");
+        }
+    }
+    for fd in LISTEN_FDS_START..LISTEN_FDS_START + count {
+        unsafe { libc::fcntl(fd, libc::F_SETFD, libc::FD_CLOEXEC) };
+    }
+    if !names.is_null() {
+        if count == 0 {
+            unsafe { *names = std::ptr::null_mut() };
+        } else {
+            let list: Vec<&str> = match &fdnames {
+                Some(s) => s.split(':').collect(),
+                None => Vec::new(),
+            };
+            let size = std::mem::size_of::<*mut c_char>() * (count as usize + 1);
+            let arr = unsafe { libc::malloc(size) } as *mut *mut c_char;
+            if arr.is_null() {
+                return -libc::ENOMEM;
+            }
+            for i in 0..count as usize {
+                let name = list.get(i).copied().unwrap_or("unknown");
+                let c = std::ffi::CString::new(name).unwrap_or_else(|_| c"unknown".into());
+                unsafe { *arr.add(i) = libc::strdup(c.as_ptr()) };
+            }
+            unsafe {
+                *arr.add(count as usize) = std::ptr::null_mut();
+                *names = arr;
+            }
+        }
+    }
+    count
+}
+
+pub unsafe fn sd_journal_stream_fd(
+    _identifier: *const c_uchar,
+    _priority: c_int,
+    _level_prefix: c_int,
+) -> c_int {
+    let fd = unsafe { libc::fcntl(2, libc::F_DUPFD_CLOEXEC, 3) };
+    if fd < 0 { -errno() } else { fd }
+}
+
+pub unsafe fn sd_id128_get_machine_app_specific(app_id: sd_id128_t, ret: *mut sd_id128_t) -> c_int {
+    if ret.is_null() {
+        return -libc::EINVAL;
+    }
+    let text = match std::fs::read_to_string("/etc/machine-id") {
+        Ok(t) => t,
+        Err(e) => return -e.raw_os_error().unwrap_or(libc::ENOENT),
+    };
+    let hex = text.trim();
+    if hex.len() != 32 {
+        return -libc::ENOMEDIUM;
+    }
+    let mut machine = [0u8; 16];
+    for i in 0..16 {
+        match u8::from_str_radix(&hex[2 * i..2 * i + 2], 16) {
+            Ok(b) => machine[i] = b,
+            Err(_) => return -libc::EINVAL,
+        }
+    }
+    if machine.iter().all(|b| *b == 0) {
+        return -libc::ENOMEDIUM;
+    }
+    let mac = hmac_sha256(&machine, &app_id.bytes);
+    let mut id = [0u8; 16];
+    id.copy_from_slice(&mac[..16]);
+    // a v4 UUID, as systemd's id128_make_v4_uuid()
+    id[6] = (id[6] & 0x0F) | 0x40;
+    id[8] = (id[8] & 0x3F) | 0x80;
+    unsafe { (*ret).bytes = id };
+    0
+}
+
+fn hmac_sha256(key: &[u8], msg: &[u8]) -> [u8; 32] {
+    // keys up to the block size (64 bytes) are used as they are
+    let mut k = [0u8; 64];
+    k[..key.len()].copy_from_slice(key);
+    let mut inner = Vec::with_capacity(64 + msg.len());
+    inner.extend(k.iter().map(|b| b ^ 0x36));
+    inner.extend_from_slice(msg);
+    let ih = sha256(&inner);
+    let mut outer = Vec::with_capacity(96);
+    outer.extend(k.iter().map(|b| b ^ 0x5c));
+    outer.extend_from_slice(&ih);
+    sha256(&outer)
+}
+
+fn sha256(data: &[u8]) -> [u8; 32] {
+    const K: [u32; 64] = [
+        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4,
+        0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe,
+        0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f,
+        0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
+        0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc,
+        0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b,
+        0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116,
+        0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7,
+        0xc67178f2,
+    ];
+    let mut h: [u32; 8] = [
+        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab,
+        0x5be0cd19,
+    ];
+    let mut m = data.to_vec();
+    let bits = (data.len() as u64).wrapping_mul(8);
+    m.push(0x80);
+    while m.len() % 64 != 56 {
+        m.push(0);
+    }
+    m.extend_from_slice(&bits.to_be_bytes());
+    for chunk in m.chunks(64) {
+        let mut w = [0u32; 64];
+        for i in 0..16 {
+            w[i] = u32::from_be_bytes([chunk[4 * i], chunk[4 * i + 1], chunk[4 * i + 2], chunk[4 * i + 3]]);
+        }
+        for i in 16..64 {
+            let s0 = w[i - 15].rotate_right(7) ^ w[i - 15].rotate_right(18) ^ (w[i - 15] >> 3);
+            let s1 = w[i - 2].rotate_right(17) ^ w[i - 2].rotate_right(19) ^ (w[i - 2] >> 10);
+            w[i] = w[i - 16].wrapping_add(s0).wrapping_add(w[i - 7]).wrapping_add(s1);
+        }
+        let mut v = h;
+        for i in 0..64 {
+            let s1 = v[4].rotate_right(6) ^ v[4].rotate_right(11) ^ v[4].rotate_right(25);
+            let ch = (v[4] & v[5]) ^ (!v[4] & v[6]);
+            let t1 = v[7].wrapping_add(s1).wrapping_add(ch).wrapping_add(K[i]).wrapping_add(w[i]);
+            let s0 = v[0].rotate_right(2) ^ v[0].rotate_right(13) ^ v[0].rotate_right(22);
+            let maj = (v[0] & v[1]) ^ (v[0] & v[2]) ^ (v[1] & v[2]);
+            let t2 = s0.wrapping_add(maj);
+            v[7] = v[6];
+            v[6] = v[5];
+            v[5] = v[4];
+            v[4] = v[3].wrapping_add(t1);
+            v[3] = v[2];
+            v[2] = v[1];
+            v[1] = v[0];
+            v[0] = t1.wrapping_add(t2);
+        }
+        for i in 0..8 {
+            h[i] = h[i].wrapping_add(v[i]);
+        }
+    }
+    let mut out = [0u8; 32];
+    for i in 0..8 {
+        out[4 * i..4 * i + 4].copy_from_slice(&h[i].to_be_bytes());
+    }
+    out
+}
+
+#[test]
+fn test_sha256() {
+    let d = sha256(b"abc");
+    assert_eq!(d[0], 0xba);
+    assert_eq!(d[31], 0xad);
+}
