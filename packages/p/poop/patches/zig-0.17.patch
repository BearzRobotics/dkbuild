+/// The program `name` is: itself if it has a '/', else the first match on PATH.
+fn findProgram(arena: std.mem.Allocator, name: []const u8, path_env: ?[]const u8) ![:0]const u8 {
+    if (std.mem.indexOfScalar(u8, name, '/') != null) return arena.dupeSentinel(u8, name, 0);
+    var it = std.mem.tokenizeScalar(u8, path_env orelse "/usr/local/bin:/usr/bin:/bin", ':');
+    while (it.next()) |dir| {
+        const full = try std.fmt.allocPrintSentinel(arena, "{s}/{s}", .{ dir, name }, 0);
+        if (linux.errno(linux.access(full, linux.X_OK)) == .SUCCESS) return full;
+    }
+    std.debug.print("error: {s}: command not found\n", .{name});
+    std.process.exit(1);
+}
