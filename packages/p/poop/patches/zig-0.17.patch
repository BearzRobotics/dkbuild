+    const Color = enum { reset, bold, dim, red, green, yellow, magenta, cyan, white, bright_red, bright_green, bright_yellow };
+
+    fn setColor(conf: TtyConfig, w: *Out, color: Color) !void {
+        if (conf == .no_color) return;
+        try w.writeAll(switch (color) {
