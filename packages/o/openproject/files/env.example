# /etc/openproject/env: read by /usr/lib/openproject/run (sh syntax).
# Copy to /etc/openproject/env (root:openproject, mode 0640) and fill in.

# PostgreSQL (required)
DATABASE_URL=postgres://openproject:CHANGE-ME@127.0.0.1/openproject
# Rails' secret: generate one, e.g. `openssl rand -hex 64`
SECRET_KEY_BASE=
# the name and scheme users reach OpenProject by
OPENPROJECT_HOST__NAME=localhost
OPENPROJECT_HTTPS=false
OPENPROJECT_DEFAULT__LANGUAGE=en

# memcached (optional; without it the cache is files in /opt/openproject/tmp)
#OPENPROJECT_RAILS__CACHE__STORE=memcache
#OPENPROJECT_CACHE__MEMCACHE__SERVER=127.0.0.1:11211

# collaborative editing (optional; the openproject-hocuspocus service):
# the same secret here and in OpenProject's settings
#SECRET=
#OPENPROJECT_COLLABORATIVE__EDITING__HOCUSPOCUS__URL=wss://openproject.example.org/hocuspocus
#OPENPROJECT_COLLABORATIVE__EDITING__HOCUSPOCUS__SECRET=
