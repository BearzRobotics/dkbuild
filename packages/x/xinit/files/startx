#!/bin/sh

# we always start on the current tty
TTY=$XDG_VTNR

if [ -z "$TTY" ]; then
    TTY=$(tty)
    TTY=${TTY#/dev/tty}
fi

if [ -z "$TTY" -o "$TTY" -ne "$TTY" ] 2> /dev/null; then
    echo "$0: must run from a tty"
    exit 1
fi

# determine the lowest unused DISPLAY
d=0
while :; do
    [ -e "/tmp/.X$d-lock" -o -S "/tmp/.X11-unix/X$d" ] || break
    d=$(($d + 1))
done
display=":$d"
unset d

# What to run inside the X server, as with upstream startx: a command given on the command line
# (`startx dkde-session --x11`) wins; else the user's ~/.config/xinitrc or ~/.xinitrc; else, with
# neither, the system default: DKDE's X11 session when it is installed, else a terminal.
if [ $# -gt 0 ] && [ "$1" != -- ]; then
    client=""
else
    client=${XDG_CONFIG_HOME:-$HOME/.config}/xinitrc
    [ -x "$client" ] || client=${HOME}/.xinitrc
    if [ ! -x "$client" ]; then
        if command -v dkde-session >/dev/null 2>&1; then
            set -- dkde-session --x11 "$@"
        elif command -v xterm >/dev/null 2>&1; then
            set -- xterm "$@"
        else
            echo "$0: no command given, no ~/.xinitrc, and neither dkde-session nor xterm is installed"
            exit 1
        fi
        client=""
    fi
fi

if [ -z "$XAUTHORITY" ]; then
    # get it away from the homedir if we can
    if [ -n "$XDG_RUNTIME_DIR" ]; then
        export XAUTHORITY="${XDG_RUNTIME_DIR}/xauthority"
    else
        export XAUTHORITY="${HOME}/.Xauthority"
    fi
fi

# ensure it exists
touch "$XAUTHORITY"

# set session type
export XDG_SESSION_TYPE=x11

xauth add "$display" . `/usr/bin/mcookie`

xinit /etc/X11/Xsession $client "$@" -- \
    /usr/bin/X "$display" vt$TTY -nolisten tcp -keeptty -noreset -auth "$XAUTHORITY"

ret=$?

xauth remove "$display"

exit $ret
