#!/bin/sh
grep -q "^transmission:" /etc/group || groupadd -r transmission
grep -q "^transmission:" /etc/passwd || useradd -r -g transmission -d /var/lib/transmission -s /usr/bin/nologin -c "Transmission daemon" transmission
mkdir -p /var/lib/transmission
chown transmission:transmission /var/lib/transmission
chmod 750 /var/lib/transmission
exit 0
