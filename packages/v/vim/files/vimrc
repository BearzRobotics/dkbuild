" /etc/vimrc: FenrirOS's settings for every vim user (after LFS's).
" Your own go in ~/.vimrc (or ~/.vim/vimrc), read after this file.

" Vim's defaults first (syntax highlighting, filetype plugins and indenting,
" incremental search, the mouse), so the settings below and your own vimrc
" change them rather than being undone by them. Vim normally uses
" defaults.vim only for people without a vimrc; here everybody gets it, once.
source $VIMRUNTIME/defaults.vim
let skip_defaults_vim = 1

set nocompatible
set backspace=indent,eol,start
syntax on
