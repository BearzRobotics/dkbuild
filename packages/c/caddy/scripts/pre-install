#!/bin/sh
# an account that cannot be made fails the script, so that apk says so
set -e
grep -q "^caddy:" /etc/group || groupadd -r caddy
grep -q "^caddy:" /etc/passwd || useradd -r -g caddy -d /var/lib/caddy -s /usr/bin/nologin -c "Caddy web server" caddy
mkdir -p /var/lib/caddy /etc/caddy
chown caddy:caddy /var/lib/caddy; chmod 750 /var/lib/caddy
