# Example /etc/mastodon/env.production (KEY=value lines; the file is read by /usr/lib/mastodon/run).
# `rails mastodon:setup` writes one for you after asking; nothing below is set by the package.
LOCAL_DOMAIN=example.org
DB_HOST=/run/postgresql
DB_USER=mastodon
DB_NAME=mastodon_production
DB_PASS=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# the secrets: generate with `bundle exec rails secret` (SECRET_KEY_BASE, OTP_SECRET) and
# `bundle exec rails mastodon:webpush:generate_vapid_key`, and the Active Record encryption keys
# (`bundle exec rails db:encryption:init`)
SECRET_KEY_BASE=
OTP_SECRET=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
