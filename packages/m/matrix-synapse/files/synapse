# Synapse Matrix homeserver. Not enabled by default (README.FenrirOS): it needs
# /etc/matrix-synapse/homeserver.yaml (generated by the admin) and a PostgreSQL database for real use.
type = process
command = /usr/bin/synapse_homeserver --config-path=/etc/matrix-synapse/homeserver.yaml
run-as = synapse
working-dir = /var/lib/matrix-synapse
logfile = /var/log/matrix-synapse.log
smooth-recovery = true
depends-on: rcboot
waits-for: syslogd
